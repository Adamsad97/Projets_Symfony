{% extends 'base.html.twig' %}

{% block title %}Liste des publications{% endblock %}

{% block body %}
    <h1 class="my-4">Liste des publications</h1>
    <div class="container">
        <div class="row">
            {% for publication in publications %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">Publication #{{ publication.id }}</h5>
                            <p class="card-text">{{ publication.contenu }}</p>
                            <span class="badge bg-primary">Publié le {{ publication.datePub ? publication.datePub|date('d/m/Y') : '' }}</span>
                            <hr>
                            <strong>Commentaires :</strong>
                            {% if publication.commentaires|length > 0 %}
                                <ul class="list-group list-group-flush">
                                    {% for commentaire in publication.commentaires %}
                                        <li class="list-group-item">
                                            {{ commentaire.contenu }}<br>
                                            <small class="text-muted">le {{ commentaire.dateCommentaire|date('d/m/Y') }}</small>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="text-muted">Aucun commentaire.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}