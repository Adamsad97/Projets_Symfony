{% extends 'base.html.twig' %}

{% block title %}Mes commentaires{% endblock %}

{% block body %}
    <h1 class="my-4">Mes commentaires</h1>
    <div class="container">
        <div class="row">
            {% for commentaire in commentaires %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">Commentaire #{{ commentaire.id }}</h5>
                            <p class="card-text">{{ commentaire.contenu }}</p>
                            <span class="badge bg-secondary">Publié le {{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d/m/Y') : '' }}</span>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info text-center">Aucun commentaire trouvé.</div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}