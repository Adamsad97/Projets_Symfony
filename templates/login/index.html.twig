{% extends 'base.html.twig' %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border rounded  bg-light">
                <div class="card-header text-center">
                <h2 class="mb-4 text-center">Connexion</h2>
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <form action="{{ path('app_login') }}" method="post">
                    <label for="username">Votre email :</label>
                    <input class="form-control" type="text" id="username" name="_username" value="{{ last_username }}" required>

                    <label for="password" class="mt-3">Votre mot de passe :</label>
                    <input class="form-control" type="password" id="password" name="_password" required>

                    <input type="hidden" name="_target_path" value="{{ path('app_account') }}">

                    <button class="btn btn-success w-100 mt-3" type="submit">Me connecter</button>
                </form>
                <br/>
                <div class="text-center">
                   Vous n'avez pas de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}